# Required — OpenRouter key powers the LLM pipeline (default inference path).
OPENROUTER_API_KEY=your_key_here

# Optional — fine-tuned Qwen2.5-7B endpoint on Modal (finetune/modal_serve.py).
# When unset, the "Fine-tuned Qwen" toggle transparently falls back to OpenRouter.
MODAL_ENDPOINT_URL=
MODAL_API_KEY=

# Only needed for the data-build pipeline (setup/), not for running the app.
INNOLITICS_API_KEY=your_innolitics_key_here

OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
DEFAULT_MODEL=meta-llama/llama-3.3-70b-instruct:free
FAST_MODEL=meta-llama/llama-3.1-8b-instruct
DB_PATH=data/db/510k.db
FAISS_INDEX_PATH=data/embeddings/devices.index
FAISS_METADATA_PATH=data/embeddings/devices_metadata.pkl
PDF_DIR=data/pdfs
FINETUNED_MODEL_PATH=finetune/output/adapter
BACKEND_PORT=8000
